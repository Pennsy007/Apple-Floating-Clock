<?xml version="1.0" encoding="utf-8"?>
<!-- 苹果 iOS 18 冰霜雪晶毛玻璃 (Apple Frost Glass) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层晶莹通透白霜，高透光率，在浅色/深色壁纸上均优雅剔透 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B3FFFFFF"
                android:centerColor="#C4F4F5F8"
                android:endColor="#D9E8EBF0" />
            <corners android:radius="44dp" />
            <stroke
                android:width="1dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>

    <!-- 顶部纯净白光反光层 -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="43dp"
                android:topRightRadius="43dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>

</layer-list>
