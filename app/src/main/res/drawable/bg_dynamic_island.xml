<?xml version="1.0" encoding="utf-8"?>
<!-- 苹果官方暗夜黑曜石毛玻璃 (Apple Midnight Obsidian Glass) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外层微弱环境阴影圈，在任何背景上都自然悬浮浮雕 -->
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="44dp" />
        </shape>
    </item>

    <!-- 黑曜石半透明微光主体（约 85% 透光度，既透壁纸又保对比度） -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D9161619"
                android:centerColor="#E6101013"
                android:endColor="#F20B0B0E" />
            <corners android:radius="44dp" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>

    <!-- 顶部 1dp 拟态天光反光晶体倒角 (Apple 工业设计标志性微光) -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="42dp"
                android:topRightRadius="42dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>

</layer-list>
