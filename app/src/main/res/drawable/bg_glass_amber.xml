<?xml version="1.0" encoding="utf-8"?>
<!-- 苹果 x 爱马仕落日暖金毛玻璃 (Apple x Hermès Sunset Amber) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层奢华半透暖褐金底板，高级内敛，绝不艳俗 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A6201812"
                android:centerColor="#BA1C140E"
                android:endColor="#CC140E0A" />
            <corners android:radius="44dp" />
            <stroke
                android:width="1dp"
                android:color="#4DE6B480" />
        </shape>
    </item>

    <!-- 顶部暖金微光反光层 -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFE6CC"
                android:endColor="#00FFE6CC" />
            <corners
                android:topLeftRadius="43dp"
                android:topRightRadius="43dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>

</layer-list>
