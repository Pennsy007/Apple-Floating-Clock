<?xml version="1.0" encoding="utf-8"?>
<!-- 苹果暮光幻紫毛玻璃 (Apple Twilight Violet) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9920152B"
                android:centerColor="#B2180E22"
                android:endColor="#CC100818" />
            <corners android:radius="44dp" />
            <stroke
                android:width="1dp"
                android:color="#4D9C75D1" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26E8D0FF"
                android:endColor="#00E8D0FF" />
            <corners
                android:topLeftRadius="43dp"
                android:topRightRadius="43dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
